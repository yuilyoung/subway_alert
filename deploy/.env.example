# Template only. Generate an actual ignored .env using generate_api_tokens.py.
BACKEND_PORT=8080
SUBWAY_API_TOKENS=
# Empty tokens intentionally leave every route except exact GET /api/health closed.
# The local compose definition deliberately fixes SEOUL_SUBWAY_KEY=sample
# and FCM_ENABLED=false. It does not read real keys from this file.
# Optional compose.postgres.yaml uses this required password. Generate a fresh
# private .env.postgres with: python3 deploy/generate_api_tokens.py --postgres --output .env.postgres
# Local DB name/user are subway_alert. Its named volume persists receipts only;
# it is not a backup. Leave this empty for ordinary memory-mode compose.yaml.
MONITOR_DB_PASSWORD=
